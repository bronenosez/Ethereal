# Frontend (Vite) — copy to .env.local to override.
# Where the admin backend (FastAPI) is reachable. Default matches the backend
# running locally on port 8000.
VITE_API_URL=http://localhost:8000

# Public site origin, used for SEO canonical URLs, Open Graph tags and the
# sitemap. Set this to your real domain in production, e.g. https://ethereal.store
VITE_SITE_URL=http://localhost:5173
