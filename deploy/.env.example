# Copy to deploy/.env on the server and fill in real values.
# docker compose reads this file for both variable interpolation and the backend.

# Public origin of the site (scheme + host). Drives the Caddy site address, the
# frontend build (VITE_API_URL/VITE_SITE_URL) and CORS.
#   https://shop.example.com  -> automatic Let's Encrypt HTTPS (needs a DNS A record)
#   http://203.0.113.10       -> plain HTTP on a bare IP (no certificate)
PUBLIC_ORIGIN=https://shop.example.com

# Email for Let's Encrypt (only used when PUBLIC_ORIGIN is an https:// domain).
ACME_EMAIL=you@example.com

# PostgreSQL (used by the db service and the backend's DATABASE_URL).
POSTGRES_USER=ethereal
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=ethereal

# JWT signing key — generate a fresh one, do NOT reuse the repo's example key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap admin account (created on first startup).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password

# Frontend and API share one origin, so CORS is same-origin; set to PUBLIC_ORIGIN.
CORS_ORIGINS=https://shop.example.com
