# Copy to deploy/.env on the server and fill in real values.
# docker compose reads this file for both variable interpolation and the backend.

# Your domain (must have an A record pointing to this server) and an email for
# Let's Encrypt certificate notifications.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# PostgreSQL (used by the db service and the backend's DATABASE_URL).
POSTGRES_USER=ethereal
POSTGRES_PASSWORD=CHANGE_ME_to_a_strong_password
POSTGRES_DB=ethereal

# JWT signing key — generate a fresh one, do NOT reuse the repo's example key:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap admin account (created on first startup).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_to_a_strong_password

# Frontend and API share one origin, so CORS is same-origin; this stays as a guard.
CORS_ORIGINS=https://example.com
