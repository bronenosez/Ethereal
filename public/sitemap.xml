<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static sitemap for the main storefront routes. Product pages (/product/:id)
  are dynamic (stored in the DB); generate and append them at build/deploy time
  or from a backend endpoint if you need every product indexed.
-->
<urlset xmlns="http://www.sitemap.org/schemas/sitemap/0.9">
  <url>
    <loc>http://localhost:5173/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>http://localhost:5173/?section=skincare</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>http://localhost:5173/?section=makeup</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>http://localhost:5173/?section=bodyhair</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
</urlset>
