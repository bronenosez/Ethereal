# Copy to .env and adjust. The backend reads these on startup.

# PostgreSQL connection string (SQLAlchemy URL).
DATABASE_URL=postgresql+psycopg2://ethereal:ethereal@localhost:5432/ethereal

# Secret used to sign JWT access tokens. Generate one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=wLeIAJ3VwDJJ-aRJNq1xGVfjwzp9eWQQN3m7MjmSnJ_8WNXiaun27OW1Mee-2FUH

# How long an admin login stays valid, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Bootstrap admin account created on startup if it does not exist yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Comma-separated origins allowed to call the API (the Vite dev server, etc.).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Run Playwright with a visible browser window (false = headless). Keep false on servers.
PARSER_HEADLESS=true
